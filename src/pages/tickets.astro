---
import { authUtils } from "@/common/libs/utils/auth.utils";
import Layout from "@/layouts/Layout.astro";
import { API_GATEWAY } from "../common/infrastructure/datasource/apiGateway";
import { bookingDatasource } from "../features/booking/infrastructure/datasource/booking.datasource";

import { IoTicket } from "react-icons/io5";
import { LuHistory } from "react-icons/lu";
import { getTicketsUsecase } from "../features/tickets/application/usecase/getTickets.usecase";
import TicketsComponent from "../features/tickets/presentation/components/Ticket/Tickets";

const bookingRepo = bookingDatasource({ api: API_GATEWAY });

const token = authUtils.getToken({ cookies: Astro.cookies });

const tickets = await getTicketsUsecase({ repo: bookingRepo }).execute({
  token,
});
const activeTickets = tickets.filter((ticket) => ticket.status === "active");
const usedTickets = tickets.filter((ticket) => ticket.status === "used");
---

<Layout>
  <section class="space-y-8">
    <h1 class="text-3xl">Your Tickets</h1>
    <section class="flex flex-col gap-4">
      <div class="flex gap-2 items-center">
        <IoTicket />
        <h2 class="font-semibold">Active Ticket</h2>
      </div>
      <TicketsComponent tickets={activeTickets} client:load />
    </section>
    <section class="flex flex-col gap-4">
      <div class="flex gap-2 items-center">
        <LuHistory />
        <h2 class="font-semibold">Booking History</h2>
      </div>
      <TicketsComponent tickets={usedTickets} client:load />
    </section>
  </section>
</Layout>
