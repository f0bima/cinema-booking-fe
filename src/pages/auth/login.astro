---
import Layout from "@/layouts/Layout.astro";

import LoginForm from "../../features/authentication/presentation/components/LoginForm/LoginForm";
import GoogleSSOButton from "../../features/authentication/presentation/components/GoogleSSOButton/GoogleSSOButton";

// const { searchParams } = Astro.url;
// const name = searchParams.get("message");
---

<Layout>
  <section class="flex-col flex gap-12">
    <h1 class="text-center text-3xl">Booking Cinema Login</h1>

    <div class="">
      <LoginForm client:load />
    </div>

    <p class="text-center">
      Don’t have an account? <a href="/auth/register" class="text-indigo-500"
        >Sign up now</a
      >
    </p>

    <!-- <pre>{JSON.stringify(user)}</pre> -->

    <GoogleSSOButton client:load />
  </section>
</Layout>
