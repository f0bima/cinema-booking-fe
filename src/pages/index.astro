---
import { API } from "../common/infrastructure/datasource/api";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

import { getStudiosUsecase } from "../features/dashboard/application/usecase/getStudios.usecase";
import { cinemaDatasource } from "../features/cinema/infrastructure/datasource/cinema.datasource";
import StudioCard from "../features/dashboard/presentation/components/StudioCard/StudioCard";

const repository = cinemaDatasource({ api: API });
const studios = await getStudiosUsecase({ repo: repository }).execute();
---

<Layout>
  <div class="grid grid-cols-3 gap-4">
    {studios.map((studio) => <StudioCard studio={studio} />)}
  </div>
</Layout>
