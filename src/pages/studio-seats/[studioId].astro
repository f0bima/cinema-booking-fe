---
import { API } from "../../common/infrastructure/datasource/api";
import { getStudioSeatsUsecase } from "../../features/dashboard/application/usecase/getStudioSeats.usecase";
import { cinemaDatasource } from "../../features/cinema/infrastructure/datasource/cinema.datasource";
const { studioId } = Astro.params;
const repository = cinemaDatasource({ api: API });
const seats = await getStudioSeatsUsecase({ repo: repository }).execute({
  studioId: parseInt(studioId),
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Studio</title>
  </head>
  <body>
    <pre>
      {JSON.stringify(seats, null, 2)}
    </pre>
  </body>
</html>
