---
import { API } from "../../common/infrastructure/datasource/api";
import { cinemaDatasource } from "../../features/cinema/infrastructure/datasource/cinema.datasource";
import { getStudioSeatsUsecase } from "../../features/dashboard/application/usecase/getStudioSeats.usecase";
import CinemaFloorPlan from "../../features/studioSeats/presentation/components/CinemaFloorPlan/CinemaFloorPlan";
import OnlineBookingButton from "../../features/studioSeats/presentation/components/OnlineBookingButton/OnlineBookingButton";

import Layout from "@/layouts/Layout.astro";

const params = Astro.params;

const studioId = parseInt(params.studioId);

const repository = cinemaDatasource({ api: API });
const seats = await getStudioSeatsUsecase({ repo: repository }).execute({
  studioId: studioId,
});

seats.sort((a, b) => {
  const getNumberSeat = (seatNumber: string) => {
    return Number(seatNumber.replace(/^\D+/g, ""));
  };

  const numberSeatA = getNumberSeat(a.seatNumber);
  const numberSeatB = getNumberSeat(b.seatNumber);

  return numberSeatA - numberSeatB;
});
---

<Layout>
  <section class="flex flex-col justify-center gap-8">
    <CinemaFloorPlan seats={seats} client:load />
    <OnlineBookingButton studioId={studioId} client:load />
  </section>
  <!-- <OfflineBookingButton studioId={studioId} client:load /> -->
</Layout>
