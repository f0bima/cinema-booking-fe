---
import "../../styles/global.css";
import { API } from "../../common/infrastructure/datasource/api";
import { bookingDatasource } from "../../features/booking/infrastructure/datasource/booking.datasource";
import { getTicketsUsecase } from "../../features/tickets/application/usecase/getTickets.usecase";
import Ticket from "../../features/tickets/presentation/components/Ticket/Ticket";

const bookingRepo = bookingDatasource({ api: API });

const tickets = await getTicketsUsecase({ repo: bookingRepo }).execute();
const activeTickets = tickets.filter((ticket) => ticket.status === "active");
const usedTickets = tickets.filter((ticket) => ticket.status === "used");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tickets</title>
  </head>
  <body>
    <section class="flex flex-col gap-12">
      <section>
        <p>Active Ticket</p>
        {activeTickets.map((ticket) => <Ticket ticket={ticket} />)}
      </section>
      <section>
        <p>History</p>
        {usedTickets.map((ticket) => <Ticket ticket={ticket} />)}
      </section>
    </section>
  </body>
</html>
