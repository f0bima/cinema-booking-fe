---
import "@/styles/global.css";

import Navigation from "@/common/presentation/component/Navigation/Navigation";
import { Toaster } from "@/components/ui/sonner";

const { pathname } = Astro.url;

const ishideNavigation = pathname.startsWith("/auth");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body class="w-full min-h-screen justify-center flex bg-indigo-100">
    <main class="max-w-md shadow-2xl w-full bg-white">
      <div class="px-4 py-20">
        <slot />
      </div>
      {
        !ishideNavigation && (
          <Navigation currentPathname={pathname} client:load />
        )
      }

      <Toaster position="top-center" client:load />
    </main>
  </body>
</html>
