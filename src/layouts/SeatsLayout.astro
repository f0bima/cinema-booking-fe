---
import { API_GATEWAY } from "@/common/infrastructure/datasource/apiGateway";
import { cinemaDatasource } from "@/features/cinema/infrastructure/datasource/cinema.datasource";
import { getStudioSeatsUsecase } from "@/features/dashboard/application/usecase/getStudioSeats.usecase";
import CinemaFloorPlan from "@/features/studioSeats/presentation/components/CinemaFloorPlan/CinemaFloorPlan";

const params = Astro.params;

const studioId = parseInt(params.studioId);

const repository = cinemaDatasource({ api: API_GATEWAY });
const seats = await getStudioSeatsUsecase({ repo: repository }).execute({
  studioId: studioId,
});
---

<section class="flex flex-col justify-center gap-8">
  <h3 class="text-xl text-center">Studio {studioId}</h3>
  <CinemaFloorPlan seats={seats} client:load />
  <slot />
</section>
